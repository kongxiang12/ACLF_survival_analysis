# ------------------------------------------------------------
# MELD / MELD-Na (specified Sodium-MELD implementation) - conventional ACLF prognostic-score baselines
# ------------------------------------------------------------
# Bilirubin/creatinine are already in conventional units (mg/dL); sodium in mmol/L; INR unitless.
# MELD/MELD-Na are single time-independent scores; once added to test_risk / dev_risk,
# they are automatically included in the C-index, AUC, and bootstrap CI of sections 21 / 21b / 26b.
calc_meld <- function(bili, inr, cr) {
  bili <- pmax(bili, 1); inr <- pmax(inr, 1); cr <- pmin(pmax(cr, 1), 4)
  3.78 * log(bili) + 11.2 * log(inr) + 9.57 * log(cr) + 6.43
}
# Sodium-MELD implementation: Trillium Gift of Life Network, TP-9-100,
# Appendix 5A (SMC and PELD Calculations), p.39: Kim-form equation with
# sodium bounded at 125-137 mmol/L. This is not the OPTN 1.32/0.033 equation.
# https://www.giftoflife.on.ca/resources/pdf/healthcare/TP-9-100.pdf
calc_meld_na <- function(meld, na) {
  na <- pmin(pmax(na, 125), 137)
  meld - na - 0.025 * meld * (140 - na) + 140
}
# Missing-value filling for MELD uses the DEVELOPMENT medians as the locked
# reference (same principle as the locked development MICE model in section 20):
# the external TEST set must NOT be filled from its own distribution, otherwise
# the validation score would leak TEST information. Both DEV and TEST are
# therefore filled with the DEVELOPMENT medians.
