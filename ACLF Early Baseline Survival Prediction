# ---- Smooth external calibration curve (IPCW, natural spline) ----
# The tertile table above (calibration_df) is the tabular summary; the figure
# below shows the CONTINUOUS predicted-vs-observed calibration curve. A
# natural-spline logistic regression of the IPCW-weighted binary endpoint on
# logit(predicted mortality) is the standard smooth external-calibration curve
# (equivalent to riskRegression::calPlot / pec::calPlot). The spline is a
# DESCRIPTIVE tool applied to the locked TEST predictions — no prognostic model
# is refitted — and censoring is handled by the same marginal IPCW weights used
# throughout (§8/§9). An event-support rug at the panel bottom shows the
# predicted risks of patients who died within the corresponding horizon.
calc_smooth_calibration <- function(time, event, p, horizon, df = 3, n_grid = 100) {
  time <- as.numeric(time); event <- as.integer(event); p <- as.numeric(p)
  ok <- is.finite(time) & !is.na(event) & is.finite(p) & p > 0 & p < 1
  if (sum(ok) < 30) return(NULL)
  t <- time[ok]; e <- event[ok]; pp <- p[ok]

  ck <- make_censor_km(t, e)
  case    <- e == 1L & t <= horizon
  control <- (t > horizon) | (e == 0L & t == horizon)
  w <- numeric(length(t)); y <- rep(NA_integer_, length(t))
  if (any(case)) {
    w[case] <- 1 / pmax(vapply(t[case], ck$G_left, numeric(1)), 1e-8)
    y[case] <- 1L
  }
  if (any(control)) {
    Gt <- ck$G_left(horizon)
    w[control] <- 1 / max(Gt, 1e-8)
    y[control] <- 0L
  }
  valid <- w > 0 & is.finite(w) & !is.na(y)
  if (sum(valid) < 30) return(NULL)
  if (sum(y[valid] == 1L) < 1L || sum(y[valid] == 0L) < 1L) return(NULL)

  lp <- log(pp[valid] / (1 - pp[valid]))
  fit <- tryCatch(
    stats::glm(
      y[valid] ~ splines::ns(lp, df = df),
      family = stats::binomial(link = "logit"),
      weights = w[valid]
    ),
    error = function(e) NULL
  )
  if (is.null(fit)) return(NULL)

  grid_lp <- seq(min(lp), max(lp), length.out = n_grid)
  grid_df <- data.frame(lp = grid_lp)
  # Approximate pointwise 95% band from the spline fit's link-scale standard
  # error; uncertainty in the IPCW weights is not additionally accounted for.
  pred_link <- stats::predict(fit, newdata = grid_df, type = "link", se.fit = TRUE)
  lo_link <- pred_link$fit - 1.96 * pred_link$se.fit
  hi_link <- pred_link$fit + 1.96 * pred_link$se.fit
  data.frame(
    Predicted = 1 / (1 + exp(-grid_lp)),
    Observed  = stats::plogis(pred_link$fit),
    Lower     = stats::plogis(lo_link),
    Upper     = stats::plogis(hi_link)
  )
}

