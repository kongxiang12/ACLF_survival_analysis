# ============================================================
# 30b. COX PH ASSUMPTION CHECK (cox.zph)
# ============================================================
# The proportional-hazards assumption is tested on the representative
# (imputation-1) final Cox model via scaled Schoenfeld residuals. The
# GLOBAL test (last row) and per-covariate rho / chi-square / P are
# saved; scaled Schoenfeld residuals are exported for diagnostics.
# ============================================================

zph_test <- tryCatch(
  survival::cox.zph(rep_models$Cox),
  error = function(e) {
    warning("cox.zph failed: ", conditionMessage(e))
    NULL
  }
)

if (!is.null(zph_test)) {

  zph_table <- as.data.frame(zph_test$table)
  zph_table <- tibble::rownames_to_column(zph_table, "Term")

  write.csv(
    zph_table,
    file.path(OUT_DIR_TXT, "11b_Cox_PH_assumption_coxzph.csv"),
    row.names = FALSE,
    fileEncoding = "UTF-8"
  )

  # Scaled Schoenfeld residuals (one column per covariate, over event
  # times). zph_test$x = event times, zph_test$y = residual matrix.
  resid_df <- data.frame(Time = zph_test$x)
  resid_df <- cbind(resid_df, as.data.frame(zph_test$y))

  write.csv(
    resid_df,
    file.path(OUT_DIR_TXT, "11b_Cox_Schoenfeld_residuals.csv"),
    row.names = FALSE,
    fileEncoding = "UTF-8"
  )

  tryCatch(
