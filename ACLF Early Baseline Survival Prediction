# ============================================================
# ============================================================
# 25. TEST CALIBRATION — FIX7 FINAL
# ============================================================
# Calibration is performed on the independent TEST set, but all
# risk-group cut points are learned from DEVELOPMENT apparent predictions.
# Each model/time point contributes multiple calibration points.
#
# Procedure:
#   DEVELOPMENT apparent risk -> development-derived tertile cutpoints
#   TEST calibrated mortality -> fixed tertile groups
#   observed TEST mortality -> IPCW estimate within each group
#
# No TEST information is used to choose cutpoints or fit calibration.
# Cut points come from FULL-development (apparent) predictions for the base
# models, and from native RSF survival (see section 23).
# ============================================================

# Calibration reporting focuses on the four developed survival models.
# MELD/MELD-Na are raw scores, not native 28/90-day mortality probabilities.
# Section 24 fits development-only score-to-probability mappings for their
# exploratory Brier/classification outputs; they are excluded from the
# calibration reporting below and from DCA in section 29.
cal_models <- setdiff(names(test_calibrated_prob), c("MELD", "MELD-Na"))

calibration_summary <- list()

# For each model/time, derive tertiles from DEVELOPMENT apparent calibrated
# probabilities, not from TEST.
for (nm in cal_models) {
  if (nm == "RSF") {
    dev_prob <- dev_rsf_mortality
  } else {
    risk_dev <- dev_risk[[nm]]
    cal_fit <- calibration_models[[nm]]
    if (is.null(cal_fit)) next
    dev_prob <- predict_calibrated_mortality(cal_fit, risk_dev, PRED_TIMES)
  }
  test_prob <- test_calibrated_prob[[nm]]

  for (j in seq_along(PRED_TIMES)) {
    tt <- PRED_TIMES[j]
    # Only the two INTERNAL cutpoints are learned from development.
    # Infinite outer bounds retain external risks outside the development range.
    inner_q <- stats::quantile(dev_prob[, j], probs = c(1/3, 2/3),
                               na.rm = TRUE, names = FALSE)
    if (any(!is.finite(inner_q))) stop("Non-finite development calibration cutpoints.")
    q <- unique(c(-Inf, inner_q, Inf))
    if (length(q) < 4L) warning("Tied tertile cutpoints: reporting fewer distinct risk groups.")
    if (any(!is.finite(test_prob[, j]))) stop("Non-finite external calibration predictions.")
    grp <- cut(test_prob[, j], breaks = q, include.lowest = TRUE, labels = FALSE)
    if (anyNA(grp)) stop("External patients were omitted from calibration groups.")
    for (g in seq_len(length(q) - 1L)) {
      ii <- which(grp == g)
      if (length(ii) == 0L) next
      observed <- calc_ipcw_observed_risk(
        test_set[[TIME_VAR]][ii], test_set[[EVENT_VAR]][ii], tt
      )
      calibration_summary[[length(calibration_summary) + 1L]] <- tibble(
        Model = nm,
        Prediction_Type = "External validation",
        Time = tt,
        Risk_Group = paste0("Tertile_", g),
        N = length(ii),
        Mean_Predicted_Mortality = mean(test_prob[ii, j], na.rm = TRUE),
        Observed_IPCW_Mortality = observed
      )
    }
  }
}

