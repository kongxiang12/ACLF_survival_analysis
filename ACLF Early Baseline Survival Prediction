calc_cindex <- function(time, event, risk) {
  ok <- is.finite(time) & !is.na(event) & is.finite(risk)
  if (sum(ok) < 5) return(NA_real_)
  z <- tryCatch(
    survival::concordance(
      survival::Surv(time[ok], event[ok]) ~ risk[ok],
      reverse = TRUE
    ),
    error = function(e) NULL
  )
  if (is.null(z)) return(NA_real_)
  as.numeric(z$concordance)
}

# Marginal censoring-survival estimator G(t).
# Censoring is represented by 1-event. For an event at time t,
# the IPCW weight uses G(t-) to avoid counting censoring at t.
make_censor_km <- function(time, event) {
  fit <- survival::survfit(survival::Surv(time, 1L - event) ~ 1)
  list(
    fit = fit,
    G_right = function(t) {
      if (!is.finite(t)) return(NA_real_)
      idx <- findInterval(t, fit$time)
      if (idx <= 0L) return(1)
      max(fit$surv[idx], 1e-8)
    },
    G_left = function(t) {
      if (!is.finite(t)) return(NA_real_)
      idx <- findInterval(t, fit$time, left.open = TRUE)
      if (idx <= 0L) return(1)
      max(fit$surv[idx], 1e-8)
    }
  )
}

# Fixed-horizon cumulative/dynamic AUC with marginal IPCW.
# Cases: death by horizon (T <= t, event=1).
# Controls: known alive beyond horizon (T > t).
# Censored before t: excluded by zero IPCW weight.
# This definition correctly treats OS=91/Censor=0 as a 90-day control.
calc_horizon_auc_ipcw <- function(time, event, risk, horizon) {
  time <- as.numeric(time)
  event <- as.integer(event)
  risk <- as.numeric(risk)
  ok <- is.finite(time) & !is.na(event) & is.finite(risk)
  if (sum(ok) < 10) return(NA_real_)
  time <- time[ok]; event <- event[ok]; risk <- risk[ok]

  ck <- make_censor_km(time, event)
  case <- event == 1L & time <= horizon
  control <- (time > horizon) | (event == 0L & time == horizon)
  if (!any(case) || !any(control)) return(NA_real_)

  wc <- numeric(length(time)); wn <- numeric(length(time))
  wc[case] <- vapply(time[case], ck$G_left, numeric(1))
  wc[case] <- 1 / pmax(wc[case], 1e-8)
  Gt <- ck$G_left(horizon)
  wn[control] <- 1 / max(Gt, 1e-8)

  ic <- which(case & is.finite(wc) & wc > 0)
  in_ <- which(control & is.finite(wn) & wn > 0)
  if (!length(ic) || !length(in_)) return(NA_real_)

  denom <- sum(wc[ic]) * sum(wn[in_])
  if (!is.finite(denom) || denom <= 0) return(NA_real_)

  # Weighted Mann–Whitney probability: P(risk_case > risk_control).
  score <- outer(risk[ic], risk[in_], "-")
  auc_pair <- (score > 0) + 0.5 * (score == 0)
  as.numeric(sum((wc[ic] %o% wn[in_]) * auc_pair) / denom)
}

calc_td_auc <- function(time, event, risk, times) {
  purrr::map_dfr(times, function(tt) {
    tibble(Time = tt, AUC = calc_horizon_auc_ipcw(time, event, risk, tt))
  })
}

# ============================================================
# 9. BRIER / IBS — FIX7 FINAL
# ============================================================
# IPCW Brier score for binary event-by-horizon outcome.
#   event by t       -> Y=1, weight 1/G(T-)
#   known alive at t -> Y=0, weight 1/G(t)
#   censored before t -> excluded
# The mean is over the full sample size n (standard IPCW form).
# ============================================================
calc_brier_from_surv_matrix <- function(time, event, surv_matrix, pred_times) {
  time <- as.numeric(time)
  event <- as.integer(event)
  surv_matrix <- as.matrix(surv_matrix)
  n <- length(time)
  if (nrow(surv_matrix) != n || ncol(surv_matrix) != length(pred_times)) {
    stop("Brier input dimension mismatch.")
  }

  ck <- make_censor_km(time, event)
  out <- vector("list", length(pred_times))

  for (j in seq_along(pred_times)) {
    tt <- pred_times[j]
    p <- pmin(pmax(1 - surv_matrix[, j], 0), 1)
    w <- numeric(n)
    y <- numeric(n)

    case <- event == 1L & time <= tt
    control <- (time > tt) | (event == 0L & time == tt)

    if (any(case)) {
      w[case] <- vapply(time[case], ck$G_left, numeric(1))
      w[case] <- 1 / pmax(w[case], 1e-8)
      y[case] <- 1
    }
    if (any(control)) {
      Gt <- ck$G_left(tt)
      w[control] <- 1 / max(Gt, 1e-8)
      y[control] <- 0
    }

    valid <- w > 0 & is.finite(w) & is.finite(p) & is.finite(y)
    brier <- if (!any(valid)) NA_real_ else sum(w[valid] * (y[valid] - p[valid])^2) / n
    out[[j]] <- tibble(Time = tt, Brier = brier, N_IPCW = sum(valid))
  }
  bind_rows(out)
}

