# 30. COX HAZARD RATIOS — RUBIN'S RULES POOLING (M IMPUTATIONS)
# ============================================================
# The final Cox model is a LIST of M models (one per imputed dataset,
# final_models$Cox). Coefficients are pooled across imputations with
# Rubin's rules:
#   pooled coefficient = mean of imputation-specific coefficients
#   total variance     = within + (1 + 1/M) * between
#   Barnard-Rubin degrees of freedom (df -> Inf if between-var ~ 0)
# HR / 95% CI / P are reported from the pooled estimate. This is the MI
# inference for the Cox model, distinct from the simple prediction
# averaging used elsewhere for risk scores.

pool_cox_rubin <- function(model_list) {
  m <- length(model_list)
  if (m < 1L) stop("pool_cox_rubin needs at least one Cox model.")

  cn <- names(stats::coef(model_list[[1]]))

  if (m == 1L) {
    fit <- model_list[[1]]
    co <- summary(fit)$coefficients
    ci <- suppressWarnings(stats::confint(fit))
    return(tibble(
      Feature = rownames(co),
      Coefficient = co[, "coef"],
      SE = co[, "se(coef)"],
      HR = exp(co[, "coef"]),
      CI_Lower = exp(ci[, 1]),
      CI_Upper = exp(ci[, 2]),
      P_value = co[, "Pr(>|z|)"],
      df = NA_real_
    ))
  }

  Q <- vapply(
    model_list,
    function(fit) stats::coef(fit)[cn],
    numeric(length(cn))
  )
  U <- vapply(
    model_list,
    function(fit) diag(stats::vcov(fit)[cn, cn, drop = FALSE]),
    numeric(length(cn))
  )

  Qbar <- rowMeans(Q)
  Ubar <- rowMeans(U)
  B <- apply(Q, 1, function(q) sum((q - mean(q))^2) / (m - 1))
  Tvar <- Ubar + (1 + 1 / m) * B

  r <- (1 + 1 / m) * B / Ubar
  df <- (m - 1) * (1 + 1 / r)^2
  df[!is.finite(r) | r <= 0] <- Inf

  se <- sqrt(Tvar)
  tstat <- Qbar / se
  tcrit <- stats::qt(0.975, df = df)
  pval <- 2 * stats::pt(-abs(tstat), df = df)

  tibble(
    Feature = cn,
    Coefficient = Qbar,
    SE = se,
    HR = exp(Qbar),
    CI_Lower = exp(Qbar - tcrit * se),
    CI_Upper = exp(Qbar + tcrit * se),
    P_value = pval,
    df = df
  )
}

