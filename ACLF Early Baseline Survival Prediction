  stats::coef(lasso_cv, s = "lambda.min")
)

lasso_sel_cols <- rownames(lasso_coef_min)[
  abs(lasso_coef_min[, 1]) > 1e-8
]

# Map the selected one-hot columns back to the ORIGINAL predictor level.
# A categorical predictor (sex_name, cirrhosis_etiology) is selected when
