fit_risk_calibration <- function(
    risk,
    development_df
) {

  survival::coxph(
    survival::Surv(
      development_df[[TIME_VAR]],
      development_df[[EVENT_VAR]]
    ) ~ risk,
    x = TRUE,
    y = TRUE
  )
}

predict_calibrated_mortality <- function(
    calibration_model,
    risk,
    times
) {

  bh <- survival::basehaz(
    calibration_model,
    centered = FALSE
  )

  out <- matrix(
    NA_real_,
    nrow = length(risk),
    ncol = length(times)
  )

  for (j in seq_along(times)) {

    tt <- times[j]

    idx <- findInterval(
      tt,
      bh$time
    )

    H0 <- if (
      idx == 0
    ) {
      0
    } else {
      bh$hazard[
        min(
          idx,
          nrow(bh)
        )
      ]
    }

    beta <- tryCatch(as.numeric(stats::coef(calibration_model)[1]), error = function(e) NA_real_)
    if (!is.finite(beta)) {
      out[, j] <- NA_real_
    } else {
      lp <- beta * risk
      lp <- pmax(pmin(lp, 50), -50)
      out[, j] <- 1 - exp(-H0 * exp(lp))
    }
  }

  colnames(out) <- paste0(
    "Mortality_",
    times,
    "d"
  )

  out
}

# IPCW observed event rate at a fixed horizon. This is the raw weighted event
# rate (used for calibration plots and the bootstrap "CalDiff" mean-calibration
# metric); it is NOT the intercept-based calibration intercept — that is
# computed separately by calc_ipcw_calibration_intercept().
calc_ipcw_observed_risk <- function(time, event, horizon, ck = NULL) {
  time <- as.numeric(time); event <- as.integer(event)
  if (is.null(ck)) ck <- make_censor_km(time, event)
  case <- event == 1L & time <= horizon
  control <- (time > horizon) | (event == 0L & time == horizon)
  w <- numeric(length(time)); y <- rep(NA_real_, length(time))
  if (any(case)) {
    w[case] <- vapply(time[case], ck$G_left, numeric(1))
    w[case] <- 1 / pmax(w[case], 1e-8)
    y[case] <- 1
  }
  if (any(control)) {
    Gt <- ck$G_left(horizon)
    w[control] <- 1 / max(Gt, 1e-8)
    y[control] <- 0
  }
  valid <- w > 0 & is.finite(w) & !is.na(y)
  if (!any(valid)) return(NA_real_)
  sum(w[valid] * y[valid]) / sum(w[valid])
}

# Horizon-specific calibration slope (IPCW binary framework).
#
# The slope is defined on the BINARY endpoint "death by `horizon`"
# (1 = died within horizon, 0 = known alive at horizon) and estimated as the
# coefficient of logit(predicted risk) in a weighted logistic regression of
# that endpoint on logit(predicted risk), where `p` is the model's predicted
# horizon-specific mortality probability. Right-censoring is handled by
# inverse probability of censoring weights (IPCW), using the Kaplan-Meier
# estimate of the censoring distribution G(.) (censoring indicator = 1-event):
#
#   * case    (event = 1, time <= horizon): weight 1 / G(time-), y = 1
#   * control (time > horizon)            : weight 1 / G(horizon), y = 0
#   * censored before horizon (event = 0, time <= horizon): the outcome is
#     UNKNOWN and must NOT be coded as 0 — these patients receive weight 0 and
#     are excluded from the regression (their information enters via G in the
#     other two groups' weights).
#
# A slope of 1 indicates perfect calibration; slope < 1 over-dispersion of
# predictions (too extreme), slope > 1 under-fitting. The 28-day and 90-day
# slopes are computed with distinct horizons and are therefore genuinely
# horizon-specific.
calc_calibration_slope <- function(time, event, p, horizon, ck = NULL) {
  time  <- as.numeric(time)
  event <- as.integer(event)
  p     <- as.numeric(p)

  ok <- is.finite(time) & !is.na(event) & is.finite(p) & p > 0 & p < 1
  if (sum(ok) < 20) return(NA_real_)

  t  <- time[ok]
  e  <- event[ok]
  pp <- p[ok]

  if (is.null(ck)) ck <- make_censor_km(t, e)

  case    <- e == 1L & t <= horizon
  control <- (t > horizon) | (e == 0L & t == horizon)

  w <- numeric(length(t))
  y <- rep(NA_integer_, length(t))

  if (any(case)) {
    w[case] <- vapply(t[case], ck$G_left, numeric(1))
    w[case] <- 1 / pmax(w[case], 1e-8)
    y[case] <- 1L
  }
  if (any(control)) {
    Gt <- ck$G_left(horizon)
    w[control] <- 1 / max(Gt, 1e-8)
    y[control] <- 0L
  }

  valid <- w > 0 & is.finite(w) & !is.na(y)
  if (sum(valid) < 20) return(NA_real_)

  # Both outcome classes must be represented for the logistic slope to be
  # identified.
  if (sum(y[valid] == 1L) < 1L || sum(y[valid] == 0L) < 1L) {
    return(NA_real_)
  }

  lp <- log(pp[valid] / (1 - pp[valid]))

  fit <- tryCatch(
    stats::glm(
      y[valid] ~ lp,
      family = stats::binomial(link = "logit"),
      weights = w[valid]
    ),
    error = function(e) NULL
  )
  if (is.null(fit)) return(NA_real_)

  as.numeric(stats::coef(fit)[2])
}

# Horizon-specific calibration intercept (calibration-in-the-large, CITL) on
# the logit scale, estimated as the intercept of an IPCW weighted logistic
# regression of the horizon-specific binary outcome on the OFFSET
# logit(predicted risk), i.e. the calibration slope is FIXED at 1:
#
#   logit(P(death by horizon)) = calibration_intercept + 1 * logit(predicted)
#
# IPCW weights are the same as for the calibration slope: cases 1/G(time-),
# controls 1/G(horizon), censored-before-horizon weight 0 (outcome unknown,
# NOT coded as 0). An intercept of 0 indicates no systematic miscalibration;
# positive = under-prediction (observed risk higher than predicted),
# negative = over-prediction. 28-day and 90-day intercepts are computed with
# distinct horizons.
calc_ipcw_calibration_intercept <- function(time, event, p, horizon, ck = NULL) {
  time  <- as.numeric(time)
  event <- as.integer(event)
  p     <- as.numeric(p)

  ok <- is.finite(time) & !is.na(event) & is.finite(p) & p > 0 & p < 1
  if (sum(ok) < 20) return(NA_real_)

  t  <- time[ok]
  e  <- event[ok]
  pp <- p[ok]

  if (is.null(ck)) ck <- make_censor_km(t, e)

  case    <- e == 1L & t <= horizon
  control <- (t > horizon) | (e == 0L & t == horizon)

  w <- numeric(length(t))
  y <- rep(NA_integer_, length(t))

  if (any(case)) {
    w[case] <- vapply(t[case], ck$G_left, numeric(1))
    w[case] <- 1 / pmax(w[case], 1e-8)
    y[case] <- 1L
  }
  if (any(control)) {
    Gt <- ck$G_left(horizon)
    w[control] <- 1 / max(Gt, 1e-8)
    y[control] <- 0L
  }

  valid <- w > 0 & is.finite(w) & !is.na(y)
  if (sum(valid) < 20) return(NA_real_)

  if (sum(y[valid] == 1L) < 1L || sum(y[valid] == 0L) < 1L) {
    return(NA_real_)
  }

  lp <- log(pp[valid] / (1 - pp[valid]))
  df_fit <- data.frame(y = y[valid], lp = lp)

  fit <- tryCatch(
    stats::glm(
      y ~ offset(lp),
      data = df_fit,
      family = stats::binomial(link = "logit"),
      weights = w[valid]
    ),
    error = function(e) NULL
  )
  if (is.null(fit)) return(NA_real_)

  as.numeric(stats::coef(fit)[1])
}

# Integrated Calibration Index (ICI) + E50/E90 (Austin & Steyerberg 2019),
# horizon-specific and IPCW-weighted, using the same natural-spline smooth
# calibration curve as calc_smooth_calibration(). For each patient, the
# smoothed (spline) observed risk at their OWN predicted risk is compared to
# the diagonal; the absolute error |predicted - smoothed(predicted)| is
# summarized by its mean (ICI), median (E50) and 90th percentile (E90).
# Lower values indicate better calibration. IPCW weights are identical to the
# calibration slope / intercept: cases 1/G(time-), controls 1/G(horizon),
# censored-before-horizon weight 0 (outcome unknown, NOT coded as 0).
calc_ici_e50_e90 <- function(time, event, p, horizon, df = 3, ck = NULL) {
  time  <- as.numeric(time)
  event <- as.integer(event)
  p     <- as.numeric(p)

  ok <- is.finite(time) & !is.na(event) & is.finite(p) & p > 0 & p < 1
  if (sum(ok) < 30) return(c(ICI = NA_real_, E50 = NA_real_, E90 = NA_real_))

  t  <- time[ok]
  e  <- event[ok]
  pp <- p[ok]

  if (is.null(ck)) ck <- make_censor_km(t, e)

  case    <- e == 1L & t <= horizon
  control <- (t > horizon) | (e == 0L & t == horizon)

  w <- numeric(length(t))
  y <- rep(NA_integer_, length(t))

  if (any(case)) {
    w[case] <- vapply(t[case], ck$G_left, numeric(1))
    w[case] <- 1 / pmax(w[case], 1e-8)
    y[case] <- 1L
  }
  if (any(control)) {
    Gt <- ck$G_left(horizon)
    w[control] <- 1 / max(Gt, 1e-8)
    y[control] <- 0L
  }

  valid <- w > 0 & is.finite(w) & !is.na(y)
  if (sum(valid) < 30) return(c(ICI = NA_real_, E50 = NA_real_, E90 = NA_real_))

  if (sum(y[valid] == 1L) < 1L || sum(y[valid] == 0L) < 1L) {
    return(c(ICI = NA_real_, E50 = NA_real_, E90 = NA_real_))
  }

  lp <- log(pp[valid] / (1 - pp[valid]))

  fit <- tryCatch(
    stats::glm(
      y[valid] ~ splines::ns(lp, df = df),
      family = stats::binomial(link = "logit"),
      weights = w[valid]
    ),
    error = function(e) NULL
  )
  if (is.null(fit)) return(c(ICI = NA_real_, E50 = NA_real_, E90 = NA_real_))

  smoothed <- stats::predict(
    fit, newdata = data.frame(lp = lp), type = "response"
  )
  abs_err <- abs(pp[valid] - as.numeric(smoothed))

  c(
    ICI = mean(abs_err, na.rm = TRUE),
    E50 = as.numeric(stats::median(abs_err, na.rm = TRUE)),
    E90 = as.numeric(stats::quantile(abs_err, 0.90, na.rm = TRUE))
  )
}

# 10. MODEL FUNCTIONS
# ============================================================

# ------------------------------------------------------------
# 10.1 Cox PH
# ------------------------------------------------------------

fit_cox <- function(X, time, event) {

  df <- data.frame(
    time = time,
    event = event,
    X,
    check.names = FALSE
  )

  survival::coxph(
    survival::Surv(time, event) ~ .,
    data = df,
    x = TRUE,
    y = TRUE,
    model = TRUE,
    ties = "efron"
  )
}

predict_cox_risk <- function(model, X) {

  as.numeric(
    stats::predict(
      model,
      newdata = as.data.frame(X),
      type = "lp"
    )
  )
}

# ------------------------------------------------------------
# 10.2 Elastic Net Cox
# ------------------------------------------------------------

fit_enet_cox <- function(
    X,
    time,
    event,
    alpha = 0.5
) {

  glmnet::cv.glmnet(
    x = X,
    y = survival::Surv(time, event),
    family = "cox",
    alpha = alpha,
    nfolds = 10,
    type.measure = "C",
    cox.ties = "breslow"
  )
}

predict_enet_risk <- function(
    model,
    X
) {

  as.numeric(
    stats::predict(
      model,
      newx = X,
      s = "lambda.min",
      type = "link"
    )
  )
}

# ------------------------------------------------------------
# 10.3 Random Survival Forest
# ------------------------------------------------------------
# V2 FIX:
# Uses ranger x/y interface, NOT formula interface.
# Therefore illegal formula column names no longer cause the
# previous error.
# ------------------------------------------------------------

fit_rsf <- function(
    X,
    time,
    event,
    mtry = NULL,
    min_node_size = 15,
    num_trees = 800
) {

  X <- as.data.frame(
    X,
    check.names = FALSE
  )

  if (is.null(mtry)) {
    mtry <- max(
      1,
      floor(sqrt(ncol(X)))
    )
  }

  ranger::ranger(
    x = X,
    y = survival::Surv(
      time,
      event
    ),
    num.trees = num_trees,
    mtry = min(
      mtry,
      ncol(X)
    ),
    min.node.size = min_node_size,
    splitrule = "logrank",
    importance = "permutation",
    seed = SEED_MODEL
  )
}

predict_rsf_survival <- function(
    model,
    X,
    pred_times
) {

  pr <- predict(
    model,
    data = as.data.frame(X)
  )

  surv <- pr$survival
  death_times <- pr$unique.death.times

  if (length(death_times) == 0) {

    return(
      matrix(
        1,
        nrow = nrow(X),
        ncol = length(pred_times)
      )
    )
  }

  out <- matrix(
    NA_real_,
    nrow = nrow(X),
    ncol = length(pred_times)
  )

  for (j in seq_along(pred_times)) {

    tt <- pred_times[j]

    idx <- findInterval(
      tt,
      death_times
    )

    if (idx == 0) {
      out[, j] <- 1
    } else {
      out[, j] <- surv[, idx]
    }
  }

  out
}

predict_rsf_risk <- function(
    model,
    X,
    ref_time = 90
) {

  s <- predict_rsf_survival(
    model,
    X,
    ref_time
  )

  as.numeric(
    1 - s[, 1]
  )
}

# ------------------------------------------------------------
# 10.4 XGBoost survival
# ------------------------------------------------------------
# xgboost 3.x supports survival:cox.
# We use survival:cox and treat predictions as relative risk
# scores. Absolute survival calibration is performed separately.
# ------------------------------------------------------------

fit_xgb_surv <- function(
    X,
    time,
    event,
    max_depth = 3,
    eta = 0.03,
    min_child_weight = 5,
    subsample = 0.8,
    colsample_bytree = 0.8,
    nrounds = 400
) {

  dtrain <- xgboost::xgb.DMatrix(
    data = X,
    label = time
  )

  # For xgboost survival:cox:
  # positive label = event time
  # negative label = censored time
  xgboost::setinfo(
    dtrain,
    "label",
    ifelse(
      event == 1,
      time,
      -time
    )
  )

  xgboost::xgb.train(
    params = list(
      objective = "survival:cox",
      eval_metric = "cox-nloglik",
      max_depth = max_depth,
      eta = eta,
      min_child_weight = min_child_weight,
      subsample = subsample,
      colsample_bytree = colsample_bytree,
      nthread = 2
    ),
    data = dtrain,
    nrounds = nrounds,
    verbose = 0
  )
}

predict_xgb_risk <- function(
    model,
    X
) {

  as.numeric(
    stats::predict(
      model,
      newdata = X
    )
  )
}

# ============================================================
# 11. RSF TUNING
# ============================================================

tune_rsf <- function(
    df,
    fold_id,
    n_folds
) {

  n_feats <- length(
    fit_preprocessor(
      df,
      predictor_vars,
      factor_vars
    )$columns
  )

  mtry_candidates <- unique(
    pmax(
      1,
      pmin(
        n_feats,
        c(
          floor(sqrt(n_feats)),
          floor(n_feats * 0.2),
          floor(n_feats * 0.4)
        )
      )
    )
  )

  grid <- expand.grid(
    mtry = mtry_candidates,
    min_node_size = 15
  )

  results <- vector(
    "list",
    nrow(grid)
  )

  for (g in seq_len(nrow(grid))) {

    message(
      "RSF tuning ",
      g,
      "/",
      nrow(grid)
    )

    fold_scores <- numeric(n_folds)

    for (k in seq_len(n_folds)) {

      tr <- which(fold_id != k)
      va <- which(fold_id == k)

      # Fold-specific preprocessing.
      prep <- fit_preprocessor(
        df[tr, , drop = FALSE],
        predictor_vars,
        factor_vars
      )

      Xtr <- apply_preprocessor(
        prep,
        df[tr, , drop = FALSE],
        scale = TRUE
      )

      Xva <- apply_preprocessor(
        prep,
        df[va, , drop = FALSE],
        scale = TRUE
      )

      fit <- fit_rsf(
        Xtr,
        df[[TIME_VAR]][tr],
        df[[EVENT_VAR]][tr],
        mtry = grid$mtry[g],
        min_node_size = grid$min_node_size[g],
        num_trees = 300
      )

      risk <- predict_rsf_risk(
        fit,
        Xva,
        ref_time = min(
          90,
          max(df[[TIME_VAR]][tr])
        )
      )

      fold_scores[k] <- calc_cindex(
        df[[TIME_VAR]][va],
        df[[EVENT_VAR]][va],
        risk
      )
    }

    results[[g]] <- tibble(
      mtry = grid$mtry[g],
      min_node_size = grid$min_node_size[g],
      Mean_C_index = mean(
        fold_scores,
        na.rm = TRUE
      ),
      SD_C_index = stats::sd(
        fold_scores,
        na.rm = TRUE
      )
    )
  }

  bind_rows(results)
}

