# ============================================================
# 6. PREPROCESSOR
# ============================================================
# IMPORTANT:
# This preprocessor is fitted using DEVELOPMENT only.
# For final model fitting this is appropriate.
#
# For CV, a separate preprocessor is fitted inside every fold.
# This avoids leakage from validation fold into preprocessing.
# ============================================================

fit_preprocessor <- function(train_df, predictors, factor_vars) {

  work <- train_df[, predictors, drop = FALSE]

  medians <- list()
  modes <- list()
  factor_levels <- list()

  for (v in predictors) {

    x <- work[[v]]

    if (v %in% factor_vars) {

      x <- as.character(x)

      observed <- x[!is.na(x)]

      if (length(observed) == 0) {
        stop("Categorical variable ", v, " is entirely missing in the training set.")
      }

      tab <- table(observed)

      mode_value <- names(tab)[which.max(tab)]

      lev <- sort(unique(observed))

      modes[[v]] <- mode_value
      factor_levels[[v]] <- lev

      x[is.na(x)] <- mode_value

      # Novel values will be handled in apply_preprocessor.
      work[[v]] <- factor(
        x,
        levels = lev
      )

    } else {

      x <- suppressWarnings(as.numeric(x))

      med <- stats::median(
        x,
        na.rm = TRUE
      )

      if (!is.finite(med)) {
        med <- 0
      }

      medians[[v]] <- med

      x[is.na(x)] <- med

      work[[v]] <- x
    }
  }

  mm <- stats::model.matrix(
    ~ . - 1,
    data = work,
    na.action = stats::na.pass
  )

  # Remove zero-variance columns.
  keep <- apply(
    mm,
    2,
    function(z) {
      length(unique(z[is.finite(z)])) > 1
    }
  )

  mm <- mm[, keep, drop = FALSE]

  if (ncol(mm) == 0) {
    stop("No features remain after preprocessing.")
  }

  means <- colMeans(mm)

  sds <- apply(
    mm,
    2,
    stats::sd
  )

  sds[!is.finite(sds) | sds == 0] <- 1

  list(
    predictors = predictors,
    factor_vars = factor_vars,
    medians = medians,
    modes = modes,
    factor_levels = factor_levels,
    columns = colnames(mm),
    means = means,
    sds = sds
  )
}

apply_preprocessor <- function(prep, df, scale = TRUE) {

  work <- df[, prep$predictors, drop = FALSE]

  for (v in prep$predictors) {

    x <- work[[v]]

    if (v %in% prep$factor_vars) {

      x <- as.character(x)

      x[is.na(x)] <- prep$modes[[v]]

      # Novel factor levels are treated as the mode.
      known <- prep$factor_levels[[v]]

      x[!x %in% known] <- prep$modes[[v]]

      work[[v]] <- factor(
        x,
        levels = known
      )

    } else {

      x <- suppressWarnings(as.numeric(x))

      x[is.na(x)] <- prep$medians[[v]]

      work[[v]] <- x
    }
  }

  mm <- stats::model.matrix(
    ~ . - 1,
    data = work,
    na.action = stats::na.pass
  )

  missing_cols <- setdiff(
    prep$columns,
    colnames(mm)
  )

  if (length(missing_cols) > 0) {

    add <- matrix(
      0,
      nrow = nrow(mm),
      ncol = length(missing_cols),
      dimnames = list(
        NULL,
        missing_cols
      )
    )

    mm <- cbind(
      mm,
      add
    )
  }

  extra_cols <- setdiff(
    colnames(mm),
    prep$columns
  )

  if (length(extra_cols) > 0) {

    mm <- mm[
      ,
      setdiff(
        colnames(mm),
        extra_cols
      ),
      drop = FALSE
    ]
  }

  mm <- mm[
    ,
    prep$columns,
    drop = FALSE
  ]

  if (scale) {

    mm <- sweep(
      mm,
      2,
      prep$means,
      "-"
    )

    mm <- sweep(
      mm,
      2,
      prep$sds,
      "/"
    )
  }

  mm
}

# ============================================================
# 6b. MICE MULTIPLE IMPUTATION PREPROCESSOR
# ============================================================
# Used for the OUTER-CV evaluation, the final models and the
# independent TEST. Inner hyperparameter tuning keeps the fast
# median/mode preprocessor above (tuning is insensitive to the
# imputation method).
#
# fit_mice()            -> fit MICE on a TRAINING set only.
# mice_complete_matrices() -> convert completed data to standardised
#                             model matrices (list of M).
# predict_mice()        -> impute a NEW set with the fitted model via
#                          mice.mids(newdata=...) and return M matrices.
#
# Leakage safeguard (P0): imputation uses ONLY baseline predictors.
# The outcome (OS / event indicator) and anything derived from it
# (e.g. Nelson-Aalen cumulative hazard) are deliberately NOT used as
# imputation predictors, so validation/test rows can be imputed before
# their outcome is ever observed.
# ============================================================

fit_mice <- function(train_df, predictors, factor_vars,
                     m = MICE_M, maxit = MICE_MAXIT, seed = SEED_MODEL) {

  # Leakage safeguard: imputation uses ONLY baseline predictors. No
  # outcome-derived information (OS, event indicator, Nelson-Aalen
  # cumulative hazard) enters the imputation model, so validation/test
  # rows can later be imputed without observing their outcome.
  imp <- train_df[, predictors, drop = FALSE]

  factor_levels <- list()
  for (v in factor_vars) {
    imp[[v]] <- as.factor(as.character(imp[[v]]))
    factor_levels[[v]] <- levels(imp[[v]])
  }

  meth <- rep("pmm", ncol(imp))
  names(meth) <- colnames(imp)
  for (v in factor_vars) {
    nlev <- length(unique(imp[[v]][!is.na(imp[[v]])]))
    meth[v] <- if (nlev <= 2) "logreg" else "polyreg"
  }

  mids <- mice::mice(
    imp,
    m = m,
    maxit = maxit,
    method = meth,
    printFlag = FALSE,
    seed = seed
  )

  list(
    mids = mids,
    predictors = predictors,
    factor_vars = factor_vars,
    factor_levels = factor_levels,
    m = m,
    maxit = maxit
  )
}

mice_complete_matrices <- function(mids, prep_struct, keep_rows = NULL) {
  comp <- mice::complete(mids, "all")
  lapply(comp, function(df) {
    if (!is.null(keep_rows)) {
      df <- df[keep_rows, , drop = FALSE]
    }
    apply_preprocessor(prep_struct, df)
  })
}

predict_mice <- function(mice_obj, new_df, prep_struct) {
  predictors <- mice_obj$predictors
  factor_vars <- mice_obj$factor_vars

  # Leakage safeguard: new_df's outcome (OS / event / any derived
  # hazard) is NOT touched here. A new row is imputed from its baseline
  # predictors only, mirroring fit_mice().

  newimp <- new_df[, predictors, drop = FALSE]

  for (v in factor_vars) {
    newimp[[v]] <- factor(
      as.character(newimp[[v]]),
      levels = mice_obj$factor_levels[[v]]
    )
  }

  mids_new <- mice::mice.mids(
    mice_obj$mids,
    newdata = newimp,
    maxit = mice_obj$maxit,
    printFlag = FALSE
  )

  # mice.mids(newdata = ...) returns a mids object already filtered to
  # ONLY the new rows, so no keep_rows subsetting is needed (and any
  # offset indexing would be out of bounds).
  mice_complete_matrices(
    mids_new,
    prep_struct
  )
}

