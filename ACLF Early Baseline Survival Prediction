# 29. DECISION CURVE ANALYSIS — FIX7 FINAL
# ============================================================
# Horizon-specific IPCW DCA (NOT ordinary binary DCA). For each horizon,
#   Case     = death by horizon
#   Control  = known alive beyond horizon
#   Early censoring is handled by IPCW, not treated as survival.
# Model probabilities are horizon-specific predicted MORTALITY risk:
#   - Development: FULL-development (apparent) predictions (Cox-calibrated
#     apparent risk for the risk-score models, native survival for RSF).
#   - Test: locked-model predictions (test_calibrated_prob).
# The threshold range is fixed in advance (0.05-0.80 by 0.01) and is NEVER
# used to select a cutoff, tune a model, or choose a "best" model. DCA only
# assesses clinical utility. The "Treat_All" reference uses the SAME /N
# denominator as the model net benefit, so all curves are on one scale.
# ============================================================

dca_one_ipcw <- function(time, event, p, horizon, thresholds) {
  time <- as.numeric(time); event <- as.integer(event); p <- as.numeric(p)
  ck <- make_censor_km(time, event)
  case <- event == 1L & time <= horizon
  control <- (time > horizon) | (event == 0L & time == horizon)
  w <- numeric(length(time)); y <- rep(NA_integer_, length(time))
  if (any(case)) {
    w[case] <- vapply(time[case], ck$G_left, numeric(1))
    w[case] <- 1 / pmax(w[case], 1e-8)
    y[case] <- 1L
  }
  if (any(control)) {
    Gt <- ck$G_left(horizon)
    w[control] <- 1 / max(Gt, 1e-8)
    y[control] <- 0L
  }
  valid <- w > 0 & is.finite(w) & !is.na(y) & is.finite(p)
  if (sum(valid) < 10L) {
    return(tibble(Threshold = thresholds,
                  Net_Benefit = NA_real_,
                  N_IPCW = sum(valid)))
  }
  w <- w[valid]; y <- y[valid]; p <- p[valid]
  N <- length(time)
  map_dfr(thresholds, function(th) {
    positive <- p >= th
    tp_w <- sum(w * positive * (y == 1L))
    fp_w <- sum(w * positive * (y == 0L))
    nb <- (tp_w / N) - (fp_w / N) * th / (1 - th)
    tibble(Threshold = th, Net_Benefit = nb, N_IPCW = sum(valid))
  })
}

# IPCW case/control weight sums for a fixed horizon, used to put the
# "Treat All" reference on the same /N scale as the model net benefit.
calc_ipcw_case_control_weights <- function(time, event, horizon) {
  time <- as.numeric(time); event <- as.integer(event)
  ck <- make_censor_km(time, event)
  case <- event == 1L & time <= horizon
  control <- (time > horizon) | (event == 0L & time == horizon)
  w <- numeric(length(time))
  if (any(case)) {
    w[case] <- 1 / pmax(vapply(time[case], ck$G_left, numeric(1)), 1e-8)
  }
  if (any(control)) {
    w[control] <- 1 / max(ck$G_left(horizon), 1e-8)
  }
  list(C = sum(w[case]), K = sum(w[control]), N = length(time))
}

