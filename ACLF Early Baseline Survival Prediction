# ============================================================
# 26b. TEST 95% CONFIDENCE INTERVALS — BOOTSTRAP (FINAL ONLY)
# ============================================================
# The external validation (TEST) set point estimates are complemented
# with bootstrap 95% CIs (percentile method) to quantify sampling
# uncertainty of the independent evaluation.
#
# IMPORTANT: bootstrap resamples the TEST evaluation set only. The
# locked model predictions are held fixed — no model is refitted and no
# hyperparameter / cutoff / calibration parameter is re-tuned. Bootstrap
# is used solely to quantify sampling uncertainty of the final
# independent performance estimates.
# ============================================================

BOOTSTRAP_B <- 1000

bootstrap_test_ci <- function(B = BOOTSTRAP_B, seed = SEED_MODEL) {
  n <- nrow(test_set)
  time <- test_set[[TIME_VAR]]
  event <- test_set[[EVENT_VAR]]

  disc_models <- names(test_risk)

  # Survival matrices for Brier scoring: RSF native survival + calibrated
  # mortality (converted to survival) for every other calibrated model.
  surv_mats <- list()
  surv_mats[["RSF"]] <- test_rsf_surv
  for (nm in setdiff(names(test_calibrated_prob), "RSF")) {
    surv_mats[[nm]] <- 1 - test_calibrated_prob[[nm]]
  }

  metric_names <- c(
    unlist(lapply(disc_models, function(nm)
      paste0(nm, c("_C_index", "_AUC_28d", "_AUC_90d")))),
    unlist(lapply(names(surv_mats), function(nm)
      paste0(nm, c("_Brier_28d", "_Brier_90d")))),
    unlist(lapply(cal_models, function(nm)
      paste0(nm, "_CalDiff_", PRED_TIMES, "d"))),
    unlist(lapply(cal_models, function(nm)
      paste0(nm, "_CITL_", PRED_TIMES, "d"))),
    unlist(lapply(cal_models, function(nm)
      paste0(nm, "_CalSlope_", PRED_TIMES, "d"))),
    unlist(lapply(cal_models, function(nm)
      paste0(nm, "_ICI_", PRED_TIMES, "d"))),
    unlist(lapply(cal_models, function(nm)
      paste0(nm, "_E50_", PRED_TIMES, "d"))),
    unlist(lapply(cal_models, function(nm)
      paste0(nm, "_E90_", PRED_TIMES, "d")))
  )

  boot_mat <- matrix(
    NA_real_, nrow = B, ncol = length(metric_names),
    dimnames = list(NULL, metric_names)
  )

  set.seed(seed)
  for (b in seq_len(B)) {
    idx <- sample.int(n, replace = TRUE)
    tb <- time[idx]; eb <- event[idx]
    ck_b <- make_censor_km(tb, eb)

    for (nm in disc_models) {
      r <- test_risk[[nm]][idx]
      boot_mat[b, paste0(nm, "_C_index")] <- calc_cindex(tb, eb, r)
      if (nm == "RSF") {
        # RSF: horizon-specific risk (1 - S(t)), not a single 90-day risk.
        boot_mat[b, paste0(nm, "_AUC_28d")] <- calc_horizon_auc_ipcw(
          tb, eb, 1 - test_rsf_surv[idx, "Survival_28d"], 28
        )
        boot_mat[b, paste0(nm, "_AUC_90d")] <- calc_horizon_auc_ipcw(
          tb, eb, 1 - test_rsf_surv[idx, "Survival_90d"], 90
        )
      } else {
        auc <- calc_td_auc(tb, eb, r, PRED_TIMES)
        boot_mat[b, paste0(nm, "_AUC_28d")] <- auc$AUC[match(28, auc$Time)]
        boot_mat[b, paste0(nm, "_AUC_90d")] <- auc$AUC[match(90, auc$Time)]
      }
    }

    for (nm in names(surv_mats)) {
      sm <- surv_mats[[nm]][idx, , drop = FALSE]
      bs <- calc_brier_from_surv_matrix(tb, eb, sm, PRED_TIMES)
      boot_mat[b, paste0(nm, "_Brier_28d")] <- bs$Brier[match(28, bs$Time)]
      boot_mat[b, paste0(nm, "_Brier_90d")] <- bs$Brier[match(90, bs$Time)]
    }

    for (nm in cal_models) {
      p <- test_calibrated_prob[[nm]][idx, , drop = FALSE]
      for (j in seq_along(PRED_TIMES)) {
        tt <- PRED_TIMES[j]
        obs <- calc_ipcw_observed_risk(tb, eb, tt, ck = ck_b)
        # CalDiff = observed-minus-predicted mean-calibration difference
        # (kept as a complementary metric, NOT a calibration intercept).
        boot_mat[b, paste0(nm, "_CalDiff_", tt, "d")] <-
          obs - mean(p[, j], na.rm = TRUE)
        # Strict IPCW calibration intercept (CITL): glm(y ~ offset(logit p),
        # weights = IPCW), slope fixed at 1. Refit on this bootstrap sample.
        boot_mat[b, paste0(nm, "_CITL_", tt, "d")] <-
          calc_ipcw_calibration_intercept(tb, eb, p[, j], tt, ck = ck_b)
        # Calibration slope (coefficient of logit p in an IPCW-weighted
        # logistic regression, slope free) and ICI / E50 / E90.
        boot_mat[b, paste0(nm, "_CalSlope_", tt, "d")] <-
          calc_calibration_slope(tb, eb, p[, j], tt, ck = ck_b)
        ici <- calc_ici_e50_e90(tb, eb, p[, j], tt, ck = ck_b)
        boot_mat[b, paste0(nm, "_ICI_", tt, "d")] <- ici[["ICI"]]
        boot_mat[b, paste0(nm, "_E50_", tt, "d")] <- ici[["E50"]]
        boot_mat[b, paste0(nm, "_E90_", tt, "d")] <- ici[["E90"]]
      }
    }
  }

  # Point estimates on the full (unresampled) locked TEST set.
  point <- setNames(numeric(length(metric_names)), metric_names)
  for (nm in disc_models) {
    r <- test_risk[[nm]]
    point[paste0(nm, "_C_index")] <- calc_cindex(time, event, r)
    if (nm == "RSF") {
      point[paste0(nm, "_AUC_28d")] <- calc_horizon_auc_ipcw(
        time, event, 1 - test_rsf_surv[, "Survival_28d"], 28
      )
      point[paste0(nm, "_AUC_90d")] <- calc_horizon_auc_ipcw(
        time, event, 1 - test_rsf_surv[, "Survival_90d"], 90
      )
    } else {
      auc <- calc_td_auc(time, event, r, PRED_TIMES)
      point[paste0(nm, "_AUC_28d")] <- auc$AUC[match(28, auc$Time)]
      point[paste0(nm, "_AUC_90d")] <- auc$AUC[match(90, auc$Time)]
    }
  }
  for (nm in names(surv_mats)) {
    bs <- calc_brier_from_surv_matrix(time, event, surv_mats[[nm]], PRED_TIMES)
    point[paste0(nm, "_Brier_28d")] <- bs$Brier[match(28, bs$Time)]
    point[paste0(nm, "_Brier_90d")] <- bs$Brier[match(90, bs$Time)]
  }
  for (nm in cal_models) {
    p <- test_calibrated_prob[[nm]]
    for (j in seq_along(PRED_TIMES)) {
      tt <- PRED_TIMES[j]
      point[paste0(nm, "_CalDiff_", tt, "d")] <-
        calc_ipcw_observed_risk(time, event, tt) - mean(p[, j], na.rm = TRUE)
      point[paste0(nm, "_CITL_", tt, "d")] <-
        calc_ipcw_calibration_intercept(time, event, p[, j], tt)
      point[paste0(nm, "_CalSlope_", tt, "d")] <-
        calc_calibration_slope(time, event, p[, j], tt)
      ici <- calc_ici_e50_e90(time, event, p[, j], tt)
      point[paste0(nm, "_ICI_", tt, "d")] <- ici[["ICI"]]
      point[paste0(nm, "_E50_", tt, "d")] <- ici[["E50"]]
      point[paste0(nm, "_E90_", tt, "d")] <- ici[["E90"]]
    }
  }

  map_dfr(metric_names, function(mn) {
    v <- boot_mat[, mn]
    v <- v[is.finite(v)]
    if (length(v) < 2) {
      return(tibble(
        Metric = mn,
        Point_Estimate = NA_real_,
        CI_Lower = NA_real_,
        CI_Upper = NA_real_,
        B_valid = length(v)
      ))
    }
    tibble(
      Metric = mn,
      Point_Estimate = as.numeric(point[mn]),
      CI_Lower = as.numeric(stats::quantile(v, 0.025, na.rm = TRUE)),
      CI_Upper = as.numeric(stats::quantile(v, 0.975, na.rm = TRUE)),
      B_valid = length(v)
    )
  })
}

test_bootstrap_ci <- bootstrap_test_ci(B = BOOTSTRAP_B, seed = SEED_MODEL)

