# TRAIN + VALIDATION TIME-DEPENDENT ROC - 4-panel figure (28d / 90d x train / validation)
# ============================================================
# Cumulative/dynamic ROC, marginal IPCW (case/control defined as for AUC). Higher risk score =
# higher predicted mortality probability, curve above the diagonal. RSF uses the horizon-specific 1 - S(t)
# (non-proportional hazards); the other models (including MELD / MELD-Na) use a single time-independent risk score.

roc_curve_ipcw <- function(time, event, risk, horizon) {
  time <- as.numeric(time); event <- as.integer(event); risk <- as.numeric(risk)
  ok <- is.finite(time) & !is.na(event) & is.finite(risk)
  time <- time[ok]; event <- event[ok]; risk <- risk[ok]

  ck <- make_censor_km(time, event)
  case <- event == 1L & time <= horizon
  control <- (time > horizon) | (event == 0L & time == horizon)
  if (!any(case) || !any(control)) return(NULL)

  w <- numeric(length(time))
  w[case] <- vapply(time[case], ck$G_left, numeric(1))
  w[case] <- 1 / pmax(w[case], 1e-8)
  Gt <- ck$G_left(horizon)
  w[control] <- 1 / max(Gt, 1e-8)

  ic <- which(case & is.finite(w) & w > 0)
  in_ <- which(control & is.finite(w) & w > 0)
  if (!length(ic) || !length(in_)) return(NULL)

  wc <- w[ic]; rc <- risk[ic]
  wn <- w[in_]; rn <- risk[in_]
  swc <- sum(wc); swn <- sum(wn)

  # Thresholds from +Inf (nobody positive) to -Inf (everybody positive).
  th <- c(Inf, sort(unique(risk), decreasing = TRUE), -Inf)
  tpr <- vapply(th, function(c) sum(wc[rc >= c]) / swc, numeric(1))
  fpr <- vapply(th, function(c) sum(wn[rn >= c]) / swn, numeric(1))

  tibble(Threshold = th, TPR = tpr, FPR = fpr)
}

