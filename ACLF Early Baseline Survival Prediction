# Column-subset helper: keep only the columns of a full model matrix that
# belong to the given original-level variables.
subset_model_columns <- function(Xm, vars, factor_vars) {
  cols <- unlist(lapply(vars, function(v) {
    if (v %in% factor_vars) {
      grep(paste0("^", v), colnames(Xm), value = TRUE)
    } else {
      v
    }
  }))
  cols <- intersect(cols, colnames(Xm))
  Xm[, cols, drop = FALSE]
}

