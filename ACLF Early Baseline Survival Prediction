make_survival_folds <- function(df, k = 10, seed = 1) {

  set.seed(seed)

  event <- df[[EVENT_VAR]]

  fold <- integer(nrow(df))

  for (g in c(0, 1)) {

    idx <- which(event == g)

    idx <- sample(idx)

    fold[idx] <- rep(
      seq_len(k),
      length.out = length(idx)
    )
  }

  fold
}

