clean_event <- function(x) {

  if (is.factor(x)) {
    x <- as.character(x)
  }

  if (is.character(x)) {

    x <- trimws(x)

    x[x %in% c(
      "0", "Alive", "alive",
      "Survive", "survive",
      "Censored", "censored"
    )] <- "0"

    x[x %in% c(
      "1", "Death", "death",
      "Dead", "dead",
      "Event", "event"
    )] <- "1"
  }

  z <- suppressWarnings(as.numeric(x))

  bad <- !is.na(z) & !z %in% c(0, 1)

  if (any(bad)) {
    stop(
      EVENT_VAR,
      " must be coded 0/1; 0 = censored/alive, 1 = death/event.\n",
      "Invalid values found: ",
      paste(unique(x[bad]), collapse = ", ")
    )
  }

  z
}

