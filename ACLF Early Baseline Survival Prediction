# ============================================================
# 6c. LASSO VARIABLE SELECTION (Cox / Elastic Net ONLY)
# ============================================================
# LASSO (L1-penalized Cox, glmnet) selects a REDUCED predictor set used
# ONLY by the conventional Cox and Elastic Net–Cox models. This lowers the
# Cox model's effective degrees of freedom (the events-per-variable ratio
# is otherwise low) while the tree-based models (RSF, XGBoost), which
# regularize internally, stay on the full predictor set.
#
# Selection is performed on the DEVELOPMENT cohort only, on the median/mode-
# imputed standardized matrix (X_dev), using the CV-minimum lambda
# (lambda.min). The TEST set is NOT involved in variable selection (no
# leakage).
# ============================================================

set.seed(SEED_MODEL)

lasso_cv <- glmnet::cv.glmnet(
  x = X_dev,
  y = y_dev,
  family = "cox",
  alpha = 1,
  nfolds = N_FOLDS,
  standardize = FALSE
)

