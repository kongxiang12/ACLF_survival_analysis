roc_build <- function(time, event, risk_list, rsf_mort, horizons, dataset_label) {
  out <- list()
  for (nm in names(risk_list)) {
    for (tt in horizons) {
      risk <- if (nm == "RSF") rsf_mort[, paste0("Mortality_", tt, "d")] else risk_list[[nm]]
      cd <- roc_curve_ipcw(time, event, risk, tt)
      if (is.null(cd)) next
      cd$Model <- nm; cd$Time <- tt
      cd$AUC <- calc_horizon_auc_ipcw(time, event, risk, tt)
      out[[length(out) + 1L]] <- cd
    }
  }
  df <- bind_rows(out); df$Dataset <- dataset_label; df
}

