# ============================================================
# 18a. SHAP FEATURE IMPORTANCE (XGBoost + RSF TreeSHAP, imputation 1)
# ============================================================
# XGBoost SHAP uses the native TreeSHAP (xgboost predcontrib=TRUE) on the
# DEVELOPMENT set with the imputation-1 representative model/matrix (same
# convention as rep_models / Cox HR / RSF importance). Interpretation only —
# not part of performance evaluation.
#
#   - XGBoost target = log-hazard risk (survival:cox margin) -> SHAP in
#     log-hazard-ratio units (additive on the relative-risk scale).
#   - One-hot dummies (sex_name, cirrhosis_etiology) are collapsed back to the
#     original predictors by summing their SHAP contributions.
#   - RSF SHAP uses native TreeSHAP via treeshap::ranger_surv.unify(type="risk")
#     on the risk-score (sum of cumulative hazards) scale — exact, not a proxy.
#     (ranger permutation importance is additionally reported in section 31.)
# ============================================================

# Collapse one-hot dummies back to the original predictors (sum contributions).
collapse_dummies <- function(S, col_names) {
  S_agg <- matrix(
    0, nrow = nrow(S), ncol = length(predictor_vars),
    dimnames = list(NULL, predictor_vars)
  )
  for (v in predictor_vars) {
    cols <- if (v %in% factor_vars) {
      grep(paste0("^", v), col_names, value = TRUE)
    } else {
      v
    }
    cols <- intersect(cols, col_names)
    if (length(cols) > 0L) S_agg[, v] <- rowSums(S[, cols, drop = FALSE])
  }
  S_agg
}

# Build SHAP values (CSV) + beeswarm/bar plots for a single model.
# Returns the two ggplots (list(beeswarm=, bar=)); they are combined into ONE
# 2x2 figure below, so the per-model single PNGs are no longer saved separately.
write_shap_outputs <- function(S_agg, baseline, model_tag, raw_X) {
  shv <- shapviz::shapviz(S_agg, X = raw_X, baseline = baseline)

  write.csv(
    S_agg,
    file.path(OUT_DIR_TXT, paste0("12_SHAP_", model_tag, "_values.csv")),
    row.names = FALSE, fileEncoding = "UTF-8"
  )

  p_bee <- shapviz::sv_importance(shv, kind = "beeswarm", max_display = 33L) +
    labs(title = paste0("SHAP — ", model_tag, " (Development, imputation 1)"))
  p_bar <- shapviz::sv_importance(shv, kind = "bar", max_display = 33L) +
    labs(title = paste0("SHAP importance — ", model_tag, " (Development, imputation 1)"))

  list(beeswarm = p_bee, bar = p_bar)
}

