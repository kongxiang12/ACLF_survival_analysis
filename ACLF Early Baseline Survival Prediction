# 29b. THRESHOLD-BASED CLASSIFICATION METRICS (28/90-day)
# ============================================================
# Confusion-matrix decision metrics at a single cutoff, complementing
# the threshold-independent AUC/C-index and the DCA net-benefit curve.
#
# - Prediction score = calibrated 28/90-day mortality probability
#   (Development apparent Cox calibration; TEST is not used for fitting).
# - Cutoff = Youden index (max IPCW-weighted sensitivity+specificity)
#   learned on DEVELOPMENT apparent calibrated probabilities.
# - TEST metrics use an IPCW-weighted confusion matrix (early-censored
#   patients excluded; survivors and deaths reweighted).
# ============================================================

message("")
message("====================================================")
message("THRESHOLD-BASED CLASSIFICATION METRICS")
message("====================================================")

youden_cutoff_ipcw <- function(time, event, p, horizon) {
  time <- as.numeric(time); event <- as.integer(event); p <- as.numeric(p)
  ck <- make_censor_km(time, event)
  case <- event == 1L & time <= horizon
  control <- (time > horizon) | (event == 0L & time == horizon)
  w <- numeric(length(time)); y <- rep(NA_integer_, length(time))
  if (any(case)) {
    w[case] <- 1 / pmax(vapply(time[case], ck$G_left, numeric(1)), 1e-8)
    y[case] <- 1L
  }
  if (any(control)) {
    w[control] <- 1 / max(ck$G_left(horizon), 1e-8)
    y[control] <- 0L
  }
  valid <- w > 0 & is.finite(w) & !is.na(y) & is.finite(p)
  if (sum(valid) < 10L) return(list(cutoff = NA_real_, youden = NA_real_))
  w <- w[valid]; y <- y[valid]; p <- p[valid]

  cand <- sort(unique(p))
  best_cut <- NA_real_; best_youden <- -Inf
  for (th in cand) {
    pos <- p >= th
    TP <- sum(w[pos & y == 1L]); FN <- sum(w[!pos & y == 1L])
    FP <- sum(w[pos & y == 0L]); TN <- sum(w[!pos & y == 0L])
    if (TP + FN <= 0 || TN + FP <= 0) next
    sens <- TP / (TP + FN); spec <- TN / (TN + FP)
    youden <- sens + spec - 1
    if (is.finite(youden) && youden > best_youden) {
      best_youden <- youden
      best_cut <- th
    }
  }
  list(cutoff = best_cut, youden = best_youden)
}

classification_at_cutoff <- function(time, event, p, cutoff, horizon) {
  time <- as.numeric(time); event <- as.integer(event); p <- as.numeric(p)
  ck <- make_censor_km(time, event)
  case <- event == 1L & time <= horizon
  control <- (time > horizon) | (event == 0L & time == horizon)
  w <- numeric(length(time)); y <- rep(NA_integer_, length(time))
  if (any(case)) {
    w[case] <- 1 / pmax(vapply(time[case], ck$G_left, numeric(1)), 1e-8)
    y[case] <- 1L
  }
  if (any(control)) {
    w[control] <- 1 / max(ck$G_left(horizon), 1e-8)
    y[control] <- 0L
  }
  valid <- w > 0 & is.finite(w) & !is.na(y) & is.finite(p)
  if (sum(valid) < 10L) return(NULL)
  w <- w[valid]; y <- y[valid]; p <- p[valid]
  pos <- p >= cutoff

  TP_raw <- sum(pos & y == 1L); FP_raw <- sum(pos & y == 0L)
  TN_raw <- sum(!pos & y == 0L); FN_raw <- sum(!pos & y == 1L)

  TP <- sum(w[pos & y == 1L]); FP <- sum(w[pos & y == 0L])
  TN <- sum(w[!pos & y == 0L]); FN <- sum(w[!pos & y == 1L])
  n <- sum(w)

  sens <- if (TP + FN > 0) TP / (TP + FN) else NA_real_
  spec <- if (TN + FP > 0) TN / (TN + FP) else NA_real_
  ppv  <- if (TP + FP > 0) TP / (TP + FP) else NA_real_
  npv  <- if (TN + FN > 0) TN / (TN + FN) else NA_real_
  f1   <- if (2 * TP + FP + FN > 0) 2 * TP / (2 * TP + FP + FN) else NA_real_
  jaccard <- if (TP + FP + FN > 0) TP / (TP + FP + FN) else NA_real_
  denom_mcc <- sqrt((TP + FP) * (TP + FN) * (TN + FP) * (TN + FN))
  mcc <- if (denom_mcc > 0) (TP * TN - FP * FN) / denom_mcc else NA_real_
  po <- (TP + TN) / n
  pe <- ((TP + FP) * (TP + FN) + (TN + FP) * (TN + FN)) / (n * n)
  kappa <- if (1 - pe > 0) (po - pe) / (1 - pe) else NA_real_
  acc <- (TP + TN) / n

  list(
    N = sum(valid),
    TP_raw = TP_raw, FP_raw = FP_raw, TN_raw = TN_raw, FN_raw = FN_raw,
    TP = TP, FP = FP, TN = TN, FN = FN,
    Sensitivity = sens, Specificity = spec,
    PPV = ppv, NPV = npv,
    F1 = f1, Jaccard = jaccard,
    MCC = mcc, Kappa = kappa, Accuracy = acc
  )
}

